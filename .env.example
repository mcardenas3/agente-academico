# Copia este archivo como ".env" y cambia los valores.
# El archivo .env no se sube al repositorio.

POSTGRES_USER=agente
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=agente_academico

# Token del panel /admin: cualquier texto largo y difícil de adivinar
ADMIN_TOKEN=cambia_este_token

# Token de ngrok (https://dashboard.ngrok.com/get-started/your-authtoken) para la URL pública
NGROK_AUTHTOKEN=
# Dominio fijo de la cuenta de ngrok (opcional; sin él, la URL cambia en cada arranque)
NGROK_URL=

# Llave de la API de Claude (https://console.anthropic.com) para el auditor de respuestas
# (opcional; sin ella, el chat funciona igual, sin auditoría)
CLAUDE_API_KEY=
# Modelo que audita (opcional): claude-haiku-5-5 cuesta ~US$0.0006 por auditoría
# MODELO_AUDITOR=claude-haiku-5-5
# Tope de auditorías nuevas por día (opcional)
# LIMITE_AUDITORIAS_DIA=200
